// User program executor
// Provides sys_exec_load and sys_exec_run for single-process user space execution.
//
// Memory layout of process region (starting at procStart = FREE_MEMORY_START at time of load):
//   procStart+1  = backup of REG_A  / initial arg1 (first argument to program)
//   procStart+2  = backup of REG_B  / initial arg2
//   procStart+3  = backup of REG_C  / initial arg3
//   procStart+4..10 = backup of REG_D..REG_ERROR
//   procStart+11 = backup of REG_LAST_KEY  (initialized to "" on load)
//   procStart+12 = first user code instruction
//   procStart+13+ = remaining user code, then variable slots
//
// execSysCall/execSysReturn use: data_[procStart+i] <-> data_[i]  for i=1..11
//
// Calling convention:
//   sys_exec_load:  copy PROGRAM_COUNTER to var:sys_return; jump label:sys_exec_load
//   sys_exec_run:   copy PROGRAM_COUNTER to var:sys_return; jump label:sys_exec_run

var sys_exec_kernel_return      // kernel address to return to after user program exits
var sys_exec_old_free_memory    // saved FREE_MEMORY_START before process allocation


// ##########################################
// # sys_exec_load                          #
// ##########################################
// Load a user program from disk into memory and set up process state.
// Input:  REG_A = command line string (first word = filename, remaining = args)
// Output: REG_ERROR set on failure; on success REG_PROC_START/END_ADDRESS set,
//         REG_SYS_INTERRUPT_DATA set to "0 10 1" (ready for sys_exec_run)
// Call:   copy PROGRAM_COUNTER to var:sys_return; jump label:sys_exec_load

label sys_exec_load
    copy PROGRAM_COUNTER to var:sys_stack_return
    jump label:sys_stack_push

    // Save current FREE_MEMORY_START so sys_call_exit can restore it
    copy FREE_MEMORY_START to var:sys_exec_old_free_memory

    // ---- Parse command line ----
    var sys_exec_load_cmdline
    copy REG_A to var:sys_exec_load_cmdline

    // Remove extra spaces
    copy var:sys_exec_load_cmdline to REG_A
    copy PROGRAM_COUNTER to var:sys_return
    jump label:sys_remove_unneeded_spaces
    copy REG_RES to var:sys_exec_load_cmdline

    // Extract filename (column 1) and arguments (columns 2-4)
    var sys_exec_load_filename
    var sys_exec_load_arg1
    var sys_exec_load_arg2
    var sys_exec_load_arg3

    copy var:sys_exec_load_cmdline to REG_A
    write 1 to REG_B
    write " " to REG_C
    write OP_GET_COLUMN to REG_OP
    cpu_exec
    copy REG_RES to var:sys_exec_load_filename

    write 2 to REG_B
    cpu_exec
    copy REG_RES to var:sys_exec_load_arg1

    write 3 to REG_B
    cpu_exec
    copy REG_RES to var:sys_exec_load_arg2

    write 4 to REG_B
    cpu_exec
    copy REG_RES to var:sys_exec_load_arg3

    // ---- Allocate process memory ----
    var sys_exec_load_mem_start
    var sys_exec_load_mem_end

    copy FREE_MEMORY_START to var:sys_exec_load_mem_start

    // mem_end = mem_start + 250 (DEFAULT_PROC_MEMORY_SIZE)
    copy var:sys_exec_load_mem_start to REG_A
    write 250 to REG_B
    write OP_ADD to REG_OP
    cpu_exec
    copy REG_RES to var:sys_exec_load_mem_end

    // Check we don't exceed FREE_MEMORY_END
    copy FREE_MEMORY_END to REG_A
    copy var:sys_exec_load_mem_end to REG_B
    write OP_CMP_LT to REG_OP
    cpu_exec
    jump_if label:sys_exec_load_err_no_ram

    // Update FREE_MEMORY_START past the allocated region
    copy var:sys_exec_load_mem_end to REG_A
    write OP_INCR to REG_OP
    cpu_exec
    copy REG_RES to FREE_MEMORY_START

    // ---- Write initial args into process register backup slots ----
    // slot 1 = REG_A = arg1, slot 2 = REG_B = arg2, slot 3 = REG_C = arg3
    copy var:sys_exec_load_mem_start to REG_A
    write 1 to REG_B
    write OP_ADD to REG_OP
    cpu_exec
    copy var:sys_exec_load_arg1 to *REG_RES

    write 2 to REG_B
    cpu_exec
    copy var:sys_exec_load_arg2 to *REG_RES

    write 3 to REG_B
    cpu_exec
    copy var:sys_exec_load_arg3 to *REG_RES

    // ---- Initialize REG_LAST_KEY backup slot (procStart+11) to empty ----
    write 11 to REG_B
    cpu_exec
    write "" to *REG_RES

    // ---- Load program code starting at procStart + 12 ----
    write 12 to REG_B
    cpu_exec
    var sys_exec_load_exec_ptr
    copy REG_RES to var:sys_exec_load_exec_ptr

    // Open the program file
    var sys_exec_load_fd
    copy var:sys_exec_load_filename to REG_A
    copy PROGRAM_COUNTER to var:sys_return
    jump label:sys_fs_open
    jump_err label:sys_exec_load_err_open

    copy REG_RES to var:sys_exec_load_fd

    // Read file line by line into memory
    var sys_exec_load_line_no
    write 1 to var:sys_exec_load_line_no

    label sys_exec_load_file_loop
        copy var:sys_exec_load_fd to REG_A
        copy var:sys_exec_load_line_no to REG_B
        copy PROGRAM_COUNTER to var:sys_return
        jump label:sys_fs_read
        jump_err label:sys_exec_load_file_done

        // Store instruction in process memory
        copy REG_RES to *var:sys_exec_load_exec_ptr

        // Advance memory pointer
        copy var:sys_exec_load_exec_ptr to REG_A
        write OP_INCR to REG_OP
        cpu_exec
        copy REG_RES to var:sys_exec_load_exec_ptr

        // Advance line counter
        copy var:sys_exec_load_line_no to REG_A
        write OP_INCR to REG_OP
        cpu_exec
        copy REG_RES to var:sys_exec_load_line_no

        // Check we haven't overrun process memory
        copy var:sys_exec_load_mem_end to REG_A
        copy var:sys_exec_load_exec_ptr to REG_B
        write OP_CMP_LT to REG_OP
        cpu_exec
        jump_if label:sys_exec_load_err_too_big

        jump label:sys_exec_load_file_loop

    label sys_exec_load_file_done
        copy var:sys_exec_load_fd to REG_A
        copy PROGRAM_COUNTER to var:sys_return
        jump label:sys_fs_close

        // Set process address bounds
        copy var:sys_exec_load_mem_start to REG_PROC_START_ADDRESS
        copy var:sys_exec_load_mem_end to REG_PROC_END_ADDRESS

        // Set initial interrupt data: type=0, PC=11, ignoreResult=1 (first launch)
        // jumpNext() will advance PC to 12, which translates to procStart+12 (first instruction)
        write "0 11 1" to REG_SYS_INTERRUPT_DATA

        write "" to REG_RES
        write "" to REG_ERROR
        jump label:sys_stack_pop

    label sys_exec_load_err_too_big
        copy var:sys_exec_load_fd to REG_A
        copy PROGRAM_COUNTER to var:sys_return
        jump label:sys_fs_close
        write "" to REG_RES
        write "Program too large to load into process memory" to REG_ERROR
        copy var:sys_exec_old_free_memory to FREE_MEMORY_START
        write "" to REG_PROC_START_ADDRESS
        write "" to REG_PROC_END_ADDRESS
        jump label:sys_stack_pop

    label sys_exec_load_err_open
        write "" to REG_RES
        // REG_ERROR already set by sys_fs_open
        copy var:sys_exec_old_free_memory to FREE_MEMORY_START
        jump label:sys_stack_pop

    label sys_exec_load_err_no_ram
        write "" to REG_RES
        write "Not enough RAM to allocate process memory" to REG_ERROR
        jump label:sys_stack_pop


// ##########################################
// # sys_exec_run                           #
// ##########################################
// Execute the user program that was loaded by sys_exec_load.
// Switches CPU to user mode; returns to caller when user program calls sys_call_exit.
// Call: copy PROGRAM_COUNTER to var:sys_return; jump label:sys_exec_run
// Returns: to instruction at var:sys_return + 2 (instruction after "jump label:sys_exec_run")

label sys_exec_run
    // Calculate kernel return address:
    // caller stored PC before "jump label:sys_exec_run" in var:sys_return
    // the instruction after the jump is at var:sys_return + 2
    copy var:sys_return to REG_A
    write 2 to REG_B
    write OP_ADD to REG_OP
    cpu_exec
    copy REG_RES to var:sys_exec_kernel_return

    // Switch to user mode (CPU restores registers from process memory and jumps to saved PC)
    write OP_SYS_RETURN to REG_OP
    cpu_exec
    // Execution never continues here - user program runs until it calls sys_call_exit,
    // which then jumps to *var:sys_exec_kernel_return
